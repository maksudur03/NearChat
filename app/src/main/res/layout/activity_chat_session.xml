<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ChatSessionActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:textColor="@color/purple_200"
            android:textSize="16dp"
            android:textStyle="bold"
            tools:text="Munif" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/scOnline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Offline"
            android:textSize="20sp"
            android:textStyle="bold"
            app:switchPadding="12dp"
            app:thumbTint="@color/white"
            app:trackTint="@color/bg_online_switcher" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/scConnector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Connector"
            android:textSize="20sp"
            android:textStyle="bold"
            app:switchPadding="12dp"
            app:thumbTint="@color/white"
            app:trackTint="@color/bg_online_switcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:text="Please make sure only one of the users is connector"
            android:textColor="@color/purple_200"
            android:textSize="16sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvUsers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/flChatContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:visibility="gone" />

</FrameLayout>